#!/usr/bin/env bash
#
# pre-commit guard
#
# Activate (once per clone):  git config core.hooksPath .githooks
# Bypass:                     git commit --no-verify
#   ...which leaves no trace. This hook is fast feedback, not enforcement;


set -uo pipefail

if ! command -v betterleaks >/dev/null 2>&1; then
  {
    echo "pre-commit: betterleaks not found on PATH -- refusing to commit blind."
    echo "  install: https://github.com/betterleaks/betterleaks/releases"
    echo "  bypass:  git commit --no-verify   (only if you know what you're staging)"
  } >&2
  exit 1
fi

# Run betterleaks on staged files
exec betterleaks git --staged \
  --config .betterleaks.toml \
  --redact \
  --no-banner
