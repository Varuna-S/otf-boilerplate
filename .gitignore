# Local .terraform & terragrunt directories
.terraform/
.terragrunt-cache


# .tfstate files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info


# Crash log files
crash.log
crash.*.log


# Exclude all .tfvars files, which are likely to contain sentitive data
*.tfvars
*.tfvars.json


# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json
override.tofu
override.tofu.json
*_override.tofu
*_override.tofu.json

# Plan files
*tfplan*
*.tfplan
*.plan
plan.out
*.plan.out


# Ignore CLI configuration files
.terraformrc
terraform.rc
.tofurc
tofu.rc
tofurc

# Terragrunt
.terragrunt-cache

# .tfvars without any secrets
!common.tfvars
!regional.tfvars

# Ignore sensitive information
.envrc
.env
.env.*
!.env.example
.aws/

# Private keys
*.pem
*.key
*.ppk
id_rsa*
id_ecdsa*
id_ed25519*
*_ed25519
*_ed25519.pub
